<%- 
  include('../../partials/admin_layout', {
    title: title,
    apiBaseUrl: apiBaseUrl,
    body: `
    <div class="card">
      <div class="card-header">
        <div class="top-actions">
          <h1>Promo Videos</h1>
          <button class="btn btn-primary" id="newPromoBtn">+ New Promo Video</button>
        </div>
      </div>
      <div class="card-body">
        <div id="promosTableLoader" class="table-loader">
          <div class="loader"></div>
          <div class="loader-text">Loading videos...</div>
        </div>
        <div id="promosContainer" style="display:none;">
          <table id="promosTable">
            <thead>
              <tr>
                <th style="width:200px;">Video</th>
                <th>Title</th>
                <th>Link (Explore Now)</th>
                <th style="width:100px;">Status</th>
                <th style="width:100px;">Order</th>
                <th style="width:150px;">Actions</th>
              </tr>
            </thead>
            <tbody id="promosTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Promo Modal -->
    <div id="promoModal" class="large-modal">
      <div class="large-modal-content">
        <div class="large-modal-header">
          <h2 id="promoModalTitle">New Promo Video</h2>
          <button type="button" class="btn btn-secondary" id="closePromoModal" style="padding:6px 12px;">×</button>
        </div>
        <div class="large-modal-body">
          <form id="promoForm">
            <input type="hidden" id="promoId" />
            <input type="hidden" id="promoVideoUrl" />
            
            <div class="form-section">
              <div class="form-section-title">Video Info</div>
              <div class="form-row">
                <div class="form-group required-field">
                  <label for="promoTitle">Title</label>
                  <input id="promoTitle" placeholder="e.g. Elan - My World." required />
                </div>
                <div class="form-group">
                  <label for="promoSubtitle">Subtitle</label>
                  <input id="promoSubtitle" placeholder="e.g. My Story." />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="promoLinkUrl">Link URL</label>
                  <input id="promoLinkUrl" placeholder="e.g. /shop?category=gold" />
                </div>
                <div class="form-group">
                  <label for="promoOrderIndex">Order / Sequence</label>
                  <input id="promoOrderIndex" type="number" value="0" />
                </div>
              </div>
              <div class="form-group">
                <label for="promoStatus">Status</label>
                <select id="promoStatus">
                  <option value="true">Active</option>
                  <option value="false">Inactive</option>
                </select>
              </div>
            </div>

            <div class="form-section">
              <div class="form-section-title">Upload Video</div>
              <div class="form-group">
                <label>File (MP4, WebM)</label>
                <input type="file" id="promoVideoFile" accept="video/mp4,video/webm" style="padding:8px; border:2px dashed #ddd; border-radius:4px; background:#f8f9fa; cursor:pointer;" />
                <div id="videoUploadLoader" style="display:none; margin-top:10px;">Uploading...</div>
              </div>
              <div id="promoVideoPreview" style="margin-top:16px;"></div>
            </div>
            
            <div id="promoFormError" class="error"></div>
          </form>
        </div>
        <div class="large-modal-footer">
          <button type="button" class="btn btn-secondary" id="cancelPromoBtn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="savePromoBtn" form="promoForm">Save</button>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deletePromoModal" class="delete-modal-overlay">
      <div class="delete-modal">
        <div class="delete-modal-header">
          <h3>Delete Promo</h3>
        </div>
        <div class="delete-modal-body">
          <p>Are you sure you want to delete this promo video?</p>
        </div>
        <div class="delete-modal-actions">
          <button type="button" class="btn btn-secondary" id="deletePromoCancel">Cancel</button>
          <button type="button" class="btn btn-danger" id="deletePromoConfirm">Delete</button>
        </div>
      </div>
    </div>
    `,
    scripts: `
      <script src="/static/js/admin-promos.js"></script>
    `
  })
%>
