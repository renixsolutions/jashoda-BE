<%- 
  include('../../partials/admin_layout', {
    title: title,
    apiBaseUrl: apiBaseUrl,
    body: `
    <div class="card">
      <div class="card-header">
        <div class="top-actions">
          <h1>Collections</h1>
          <button class="btn btn-primary" id="newCollectionBtn">+ New Collection</button>
        </div>
      </div>
      <div class="card-body">
        <p style="margin-top:0; margin-bottom:16px; font-size:14px; color:#555;">
          Manage collections (e.g. Trending Now, Jashoda Elite, Festive Specials). Assign collections to products to show them in specific sections.
        </p>
        <div id="collectionsTableLoader" class="table-loader">
          <div class="loader"></div>
          <div class="loader-text">Loading collections...</div>
        </div>
        <div id="collectionsContainer" style="display:none;">
          <table id="collectionsTable">
            <thead>
              <tr>
                <th style="width:70px;">Image</th>
                <th>Name</th>
                <th>Slug</th>
                <th style="width:100px;">Sort Order</th>
                <th style="width:120px;">Status</th>
                <th style="width:150px;">Actions</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Collection Modal -->
    <div id="collectionModal" class="large-modal">
      <div class="large-modal-content" style="max-width:520px;">
        <div class="large-modal-header">
          <h2 id="collectionModalTitle">New Collection</h2>
          <button type="button" class="btn btn-secondary" id="closeCollectionModal" style="padding:6px 12px;">×</button>
        </div>
        <div class="large-modal-body">
          <form id="collectionForm">
            <input type="hidden" id="collectionId" />
            <div class="form-section" style="border-bottom:none; padding-bottom:0; margin-bottom:0;">
              <div class="form-row full">
                <div class="form-group required-field">
                  <label for="collectionName">Name</label>
                  <input id="collectionName" type="text" placeholder="e.g., Trending Now, Jashoda Elite" required />
                </div>
              </div>
              <div class="form-row full">
                <div class="form-group">
                  <label for="collectionSlug">Slug</label>
                  <input id="collectionSlug" type="text" placeholder="Auto-generated from name if left empty" />
                  <div class="help-text">Leave empty to auto-generate from name</div>
                </div>
              </div>
              <div class="form-row full">
                <div class="form-group">
                  <label for="collectionDescription">Description</label>
                  <textarea id="collectionDescription" rows="2" placeholder="Brief description of the collection"></textarea>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="collectionSortOrder">Sort Order</label>
                  <input id="collectionSortOrder" type="number" value="0" />
                </div>
                <div class="form-group">
                  <label for="collectionStatus">Status</label>
                  <select id="collectionStatus">
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                  </select>
                </div>
              </div>
              <div class="form-row full">
                <div class="form-group">
                  <label>Image</label>
                  <input type="file" id="collectionImageFile" accept="image/*" style="padding:8px; border:2px dashed #ddd; border-radius:4px; background:#f8f9fa; cursor:pointer;" />
                  <div id="collectionImagePreview" class="thumb-grid" style="margin-top:10px;"></div>
                </div>
              </div>
              <div id="collectionFormError" class="error"></div>
            </div>
          </form>
        </div>
        <div class="large-modal-footer">
          <button type="button" class="btn btn-secondary" id="cancelCollectionBtn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="saveCollectionBtn" form="collectionForm">Save</button>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteCollectionModal" class="delete-modal-overlay">
      <div class="delete-modal">
        <div class="delete-modal-header">
          <h3>Delete Collection</h3>
        </div>
        <div class="delete-modal-body">
          <p>Are you sure you want to delete this collection? Products using this collection will have their collection cleared.</p>
        </div>
        <div class="delete-modal-actions">
          <button type="button" class="btn btn-secondary" id="deleteCollectionCancel">Cancel</button>
          <button type="button" class="btn btn-danger" id="deleteCollectionConfirm">Delete</button>
        </div>
      </div>
    </div>
    `,
    scripts: `
      <script src="/static/js/admin-collections.js"></script>
    `
  })
%>
