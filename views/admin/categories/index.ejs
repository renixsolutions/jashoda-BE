<%- 
  include('../../partials/admin_layout', {
    title: title,
    apiBaseUrl: apiBaseUrl,
    body: `
    <div class="card">
      <div class="card-header">
        <div class="top-actions">
          <h1>Categories & Subcategories</h1>
          <div style="display:flex; gap:10px;">
            <button class="btn btn-primary" id="newCategoryBtn">+ New Category</button>
            <button class="btn btn-primary" id="newSubcategoryBtn">+ New Subcategory</button>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div id="categoriesTableLoader" class="table-loader">
          <div class="loader"></div>
          <div class="loader-text">Loading categories...</div>
        </div>
        <div id="categoriesContainer" style="display:none;">
          <table id="categoriesTable">
            <thead>
              <tr>
                <th style="width:40px;"></th>
                <th>Name</th>
                <th>Slug</th>
                <th style="width:120px;">Type</th>
                <th style="width:100px;">Status</th>
                <th style="width:150px;">Actions</th>
              </tr>
            </thead>
            <tbody id="categoriesTableBody"></tbody>
          </table>
          <div id="categoriesPagination" class="pagination"></div>
        </div>
      </div>
    </div>

    <!-- Category Modal -->
    <div id="categoryModal" class="large-modal">
      <div class="large-modal-content">
        <div class="large-modal-header">
          <h2 id="categoryModalTitle">New Category</h2>
          <button type="button" class="btn btn-secondary" id="closeCategoryModal" style="padding:6px 12px;">×</button>
        </div>
        <div class="large-modal-body">
          <form id="categoryForm">
            <input type="hidden" id="categoryId" />
            <input type="hidden" id="categoryParentId" />
            
            <div class="form-section">
              <div class="form-section-title">Basic Information</div>
              <div class="form-row">
                <div class="form-group required-field">
                  <label for="categoryType">Type</label>
                  <select id="categoryType" required>
                    <option value="category">Category</option>
                    <option value="subcategory">Subcategory</option>
                  </select>
                </div>
                <div class="form-group required-field" id="parentCategoryGroup" style="display:none;">
                  <label for="parentCategorySelect">Parent Category</label>
                  <select id="parentCategorySelect">
                    <option value="">Select Parent Category</option>
                  </select>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group required-field">
                  <label for="categoryName">Name</label>
                  <input id="categoryName" required placeholder="Enter category name" />
                </div>
                <div class="form-group">
                  <label for="categoryStatus">Status</label>
                  <select id="categoryStatus">
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="categorySlug">Slug</label>
                <input id="categorySlug" placeholder="Auto-generated from name if left empty" />
                <div class="help-text">Leave empty to auto-generate from name</div>
              </div>
              <div class="form-group">
                <label for="categoryDescription">Description</label>
                <textarea id="categoryDescription" rows="4" placeholder="Enter category description"></textarea>
              </div>
            </div>

            <div class="form-section">
              <div class="form-section-title">Image</div>
              <div class="form-group">
                <label>Upload & Crop Image</label>
                <input type="file" id="categoryImageFile" accept="image/*" style="padding:8px; border:2px dashed #ddd; border-radius:4px; background:#f8f9fa; cursor:pointer;" />
                <div id="categoryCropper" class="cropper-wrapper" style="display:none; margin-top:16px;">
                  <div class="cropper-header">
                    <span>Adjust crop (square)</span>
                    <span id="categoryCropInfo"></span>
                  </div>
                  <div class="cropper-canvas-container">
                    <canvas id="categoryCropCanvas" width="300" height="300"></canvas>
                  </div>
                  <div class="cropper-controls">
                    <span>Zoom</span>
                    <input type="range" id="categoryCropZoom" min="0.5" max="2" value="1" step="0.05" />
                    <div style="display:flex; gap:8px;">
                      <button type="button" class="btn btn-secondary" id="categoryCropCancel">Clear</button>
                      <button type="button" class="btn btn-primary" id="categoryCropUpload">Upload</button>
                    </div>
                  </div>
                </div>
                <div id="categoryImagePreview" class="thumb-grid" style="margin-top:16px;"></div>
              </div>
            </div>
            
            <div id="categoryFormError" class="error"></div>
          </form>
        </div>
        <div class="large-modal-footer">
          <button type="button" class="btn btn-secondary" id="cancelCategoryBtn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="saveCategoryBtn" form="categoryForm">Save</button>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteCategoryModal" class="delete-modal-overlay">
      <div class="delete-modal">
        <div class="delete-modal-header">
          <h3>Delete Category</h3>
        </div>
        <div class="delete-modal-body">
          <p>Are you sure you want to delete this category? This action cannot be undone and will also delete all associated subcategories.</p>
        </div>
        <div class="delete-modal-actions">
          <button type="button" class="btn btn-secondary" id="deleteCategoryCancel">Cancel</button>
          <button type="button" class="btn btn-danger" id="deleteCategoryConfirm">Delete</button>
        </div>
      </div>
    </div>
    `,
    scripts: `
      <script src="/static/js/admin-categories.js"></script>
    `
  })
%>
