<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= title || 'Reset Password' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: linear-gradient(135deg, #f0f2f5 0%, #e4e8ef 100%);
      margin: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh;
    }
    .card {
      background: #fff; padding: 40px 36px; border-radius: 14px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.10); width: 380px;
      border: 1px solid #e4e8ef;
    }
    .brand { font-weight: 700; font-size: 18px; color: #1a202c; letter-spacing: 0.04em; margin-bottom: 4px; }
    h1 { margin: 0 0 4px; font-size: 22px; color: #1a202c; font-weight: 700; }
    p.subtitle { margin: 0 0 28px; font-size: 13px; color: #6b7280; }
    .field { margin-bottom: 18px; }
    .field label { display: block; margin-bottom: 6px; font-size: 13px; color: #374151; font-weight: 500; }
    .field input {
      width: 100%; padding: 11px 14px; font-size: 14px;
      border: 1.5px solid #d1d5db; border-radius: 8px; outline: none;
      transition: border-color 0.2s, box-shadow 0.2s; color: #1a202c;
    }
    .field input:focus { border-color: #1a202c; box-shadow: 0 0 0 3px rgba(26,32,44,0.08); }
    .hint { font-size: 12px; color: #9ca3af; margin-top: 5px; }
    button.primary {
      width: 100%; padding: 12px; background: #1a202c; color: #fff;
      border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600;
      transition: all 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }
    button.primary:hover:not(:disabled) { background: #2d3748; transform: translateY(-1px); }
    button.primary:disabled { opacity: 0.65; cursor: not-allowed; }
    .error { color: #dc2626; margin-top: 10px; font-size: 13px; min-height: 18px; }
    .success { color: #16a34a; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 14px 16px; font-size: 14px; margin-top: 16px; display: none; line-height: 1.5; }
    .invalid-token { color: #dc2626; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 14px 16px; font-size: 14px; display: none; line-height: 1.5; }
    .back-link { display: block; text-align: center; margin-top: 18px; font-size: 13px; color: #6b7280; text-decoration: none; }
    .back-link:hover { color: #1a202c; }
    .icon { font-size: 36px; margin-bottom: 16px; display: block; }
    .strength { height: 4px; border-radius: 4px; margin-top: 8px; background: #e5e7eb; overflow: hidden; }
    .strength-bar { height: 100%; border-radius: 4px; width: 0; transition: width 0.3s, background 0.3s; }
  </style>
</head>
<body data-api-base="<%= apiBaseUrl %>">
  <div class="card">
    <div class="brand">Jashoda Admin</div>
    <span class="icon">🔒</span>
    <h1>Set new password</h1>
    <p class="subtitle">Choose a strong password for your admin account.</p>

    <div id="invalidTokenMsg" class="invalid-token">
      ❌ This reset link is invalid or has expired. <a href="/admin/forgot-password">Request a new one</a>.
    </div>

    <form id="resetForm">
      <div class="field">
        <label for="password">New Password</label>
        <input id="password" type="password" autocomplete="new-password" required placeholder="Min. 8 characters" minlength="8" />
        <div class="strength"><div class="strength-bar" id="strengthBar"></div></div>
        <div class="hint" id="strengthLabel"></div>
      </div>
      <div class="field">
        <label for="confirmPassword">Confirm Password</label>
        <input id="confirmPassword" type="password" autocomplete="new-password" required placeholder="Repeat password" />
      </div>
      <button type="submit" class="primary" id="submitBtn">Reset password</button>
      <div id="errorMsg" class="error"></div>
      <div id="successMsg" class="success">
        ✅ Password reset successfully! <a href="/admin/login">Sign in now</a>.
      </div>
    </form>

    <a href="/admin/login" class="back-link">&#8592; Back to sign in</a>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const apiBase = document.body.dataset.apiBase;
      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');

      const form = document.getElementById('resetForm');
      const btn = document.getElementById('submitBtn');
      const errorEl = document.getElementById('errorMsg');
      const successEl = document.getElementById('successMsg');
      const invalidEl = document.getElementById('invalidTokenMsg');
      const pwdInput = document.getElementById('password');
      const confirmInput = document.getElementById('confirmPassword');
      const strengthBar = document.getElementById('strengthBar');
      const strengthLabel = document.getElementById('strengthLabel');

      if (!token) {
        invalidEl.style.display = 'block';
        form.style.display = 'none';
        return;
      }

      // Password strength indicator
      pwdInput.addEventListener('input', () => {
        const val = pwdInput.value;
        let score = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;
        const colors = ['#ef4444', '#f97316', '#eab308', '#22c55e'];
        const labels = ['Weak', 'Fair', 'Good', 'Strong'];
        if (val.length === 0) { strengthBar.style.width = '0'; strengthLabel.textContent = ''; return; }
        strengthBar.style.width = (score * 25) + '%';
        strengthBar.style.background = colors[score - 1] || '#ef4444';
        strengthLabel.textContent = labels[score - 1] || 'Weak';
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.textContent = '';
        const password = pwdInput.value;
        const confirm = confirmInput.value;

        if (password !== confirm) {
          errorEl.textContent = 'Passwords do not match.';
          return;
        }
        if (password.length < 8) {
          errorEl.textContent = 'Password must be at least 8 characters.';
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Resetting...';

        try {
          const res = await fetch(`${apiBase}/admin/auth/reset-password`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token, password })
          });
          const data = await res.json();
          if (!res.ok) {
            if (res.status === 400 && data.message && data.message.includes('expired')) {
              invalidEl.style.display = 'block';
              form.style.display = 'none';
            } else {
              errorEl.textContent = data.message || 'Reset failed. Please try again.';
              btn.disabled = false;
              btn.textContent = 'Reset password';
            }
            return;
          }
          successEl.style.display = 'block';
          form.querySelector('.field').style.display = 'none';
          form.querySelectorAll('.field')[1].style.display = 'none';
          btn.style.display = 'none';
        } catch (err) {
          errorEl.textContent = 'Something went wrong. Please try again.';
          btn.disabled = false;
          btn.textContent = 'Reset password';
        }
      });
    });
  </script>
</body>
</html>
