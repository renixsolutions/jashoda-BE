<%- 
  include('../../partials/admin_layout', {
    title: title,
    apiBaseUrl: apiBaseUrl,
    body: `
    <div class="card">
      <div class="card-header">
        <div class="top-actions">
          <h1>Ring Sizes</h1>
          <button class="btn btn-primary" id="newSizeBtn">+ New Ring Size</button>
        </div>
      </div>
      <div class="card-body">
        <p style="margin-top:0; margin-bottom:16px; font-size:14px; color:#555;">
          Manage ring sizes and their corresponding diameters. These are used in product variations.
        </p>
        <div id="sizesTableLoader" class="table-loader">
          <div class="loader"></div>
          <div class="loader-text">Loading ring sizes...</div>
        </div>
        <div id="sizesContainer" style="display:none;">
          <table id="sizesTable">
            <thead>
              <tr>
                <th style="width:40px;">#</th>
                <th>Size</th>
                <th>Diameter (mm)</th>
                <th style="width:120px;">Status</th>
                <th style="width:120px;">Actions</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Size Modal -->
    <div id="sizeModal" class="large-modal">
      <div class="large-modal-content" style="max-width:480px;">
        <div class="large-modal-header">
          <h2 id="sizeModalTitle">New Ring Size</h2>
          <button type="button" class="btn btn-secondary" id="closeSizeModal" style="padding:6px 12px;">×</button>
        </div>
        <div class="large-modal-body">
          <form id="sizeForm">
            <input type="hidden" id="sizeId" />
            <div class="form-section" style="border-bottom:none; padding-bottom:0; margin-bottom:0;">
              <div class="form-row full">
                <div class="form-group required-field">
                  <label for="sizeName">Size</label>
                  <input id="sizeName" type="text" placeholder="e.g., 3" required />
                </div>
              </div>
              <div class="form-row full">
                <div class="form-group">
                  <label for="sizeDiameter">Diameter (mm)</label>
                  <input id="sizeDiameter" type="text" placeholder="e.g., 14.1mm" />
                </div>
              </div>
              <div class="form-row full">
                <div class="form-group">
                  <label for="sizeStatus">Status</label>
                  <select id="sizeStatus">
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                  </select>
                </div>
              </div>
              <div id="sizeFormError" class="error"></div>
            </div>
          </form>
        </div>
        <div class="large-modal-footer">
          <button type="button" class="btn btn-secondary" id="cancelSizeBtn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="saveSizeBtn" form="sizeForm">Save</button>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteSizeModal" class="delete-modal-overlay">
      <div class="delete-modal">
        <div class="delete-modal-header">
          <h3>Delete Ring Size</h3>
        </div>
        <div class="delete-modal-body">
          <p>Are you sure you want to delete this ring size? This will not affect existing product variants but will remove it from the list of options for new variants.</p>
        </div>
        <div class="delete-modal-actions">
          <button type="button" class="btn btn-secondary" id="deleteSizeCancel">Cancel</button>
          <button type="button" class="btn btn-danger" id="deleteSizeConfirm">Delete</button>
        </div>
      </div>
    </div>
    `,
    scripts: `
      <script src="/static/js/admin-ring-sizes.js"></script>
    `
  })
%>
