<%- 
  include('../../partials/admin_layout', {
    title: title,
    apiBaseUrl: apiBaseUrl,
    body: `
    <style>
      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 10px;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        max-height: 150px;
        min-height: 40px;
        overflow-y: auto;
        background: #fff;
      }
      body.dark .checkbox-grid {
        background: #020617;
        border-color: #1f2937;
      }
      .checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        cursor: pointer;
      }
      .checkbox-item input {
        width: 16px;
        height: 16px;
        cursor: pointer;
      }
      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-weight: normal;
      }
    </style>
    <div class="card">
      <div class="card-header">
        <div class="top-actions">
          <h1>Products</h1>
          <div style="display:flex; align-items:center; gap:12px; margin-left:auto;">
            <input id="search" type="text" class="top-search-input" placeholder="Search by name, SKU..." />
            <button class="btn btn-primary" id="newProductBtn">+ New Product</button>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div id="productsTableLoader" class="table-loader">
          <div class="loader"></div>
          <div class="loader-text">Loading products...</div>
        </div>
        <div id="productsContainer" style="display:none;">
          <table id="productsTable">
            <thead>
              <tr>
                <th style="width:70px;">Image</th>
                <th style="width:140px;">SKU</th>
                <th>Name</th>
                <th style="width:140px;">Category</th>
                <th style="width:100px;">Price</th>
                <th style="width:80px;">Stock</th>
                <th style="width:100px;">Status</th>
                <th style="width:150px;">Actions</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
          <div id="productsPagination" class="pagination"></div>
        </div>
        <div id="productsCardList" class="mobile-card-list"></div>
        <div id="productsEmptyState" class="empty-state">
          <span>No products found.</span>
        </div>
      </div>
    </div>

    <!-- Large Product Modal -->
    <div id="productModal" class="large-modal">
      <div class="large-modal-content">
        <div class="large-modal-header">
          <h2 id="productModalTitle">New Product</h2>
          <button type="button" class="btn btn-secondary" id="closeProductModal" style="padding:8px 14px; min-width:40px;">×</button>
        </div>
        <div class="large-modal-body">
          <form id="productForm">
            <input type="hidden" id="productId" />

            <!-- Basic Product Info -->
            <div class="form-section">
              <div class="form-section-title">Basic Product Information</div>
              <div class="form-row">
                <div class="form-group required-field">
                  <label for="productName">Product Name</label>
                  <input id="productName" required placeholder="Enter product name" />
                </div>
                <div class="form-group">
                  <label for="productSku">SKU / Product Code</label>
                  <div style="display:flex; gap:8px;">
                    <input id="productSku" placeholder="e.g., JSL-RING-001" style="flex:1;" />
                    <button type="button" class="btn btn-secondary" id="generateSkuBtn" style="padding:4px 10px; font-size:12px; min-width:auto; height:38px;">Generate</button>
                  </div>
                  <div class="help-text">Unique product identifier</div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group required-field">
                  <label for="productCategory">Category</label>
                  <select id="productCategory" required>
                    <option value="">Select Category</option>
                  </select>
                </div>
                <div class="form-group required-field">
                  <label for="productSubcategory">Subcategory</label>
                  <select id="productSubcategory" required>
                    <option value="">Select Subcategory</option>
                  </select>
                  <div class="help-text">Select category first</div>
                </div>
                <div class="form-group required-field">
                  <label>Occasions</label>
                  <div id="productOccasionsList" class="checkbox-grid">
                    <!-- Checkboxes will be dynamically loaded -->
                  </div>
                  <div class="help-text">Select one or more occasions</div>
                </div>
                <div class="form-group">
                  <label>Collections</label>
                  <div id="productCollectionsList" class="checkbox-grid">
                    <!-- Checkboxes will be dynamically loaded -->
                  </div>
                  <div class="help-text">Select one or more collections</div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productGender">Gender</label>
                  <select id="productGender">
                    <option value="">All / Any</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="productBrand">Brand / Collection</label>
                  <input id="productBrand" placeholder="Collection name" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group required-field">
                  <label for="productStatus">Status</label>
                  <select id="productStatus" required>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="productShortDescription">Short Description</label>
                <textarea id="productShortDescription" rows="2" placeholder="Brief description for listings"></textarea>
                <div class="help-text">Brief description shown in product listings</div>
              </div>
              <div class="form-group">
                <label for="productDescription">Full Description</label>
                <textarea id="productDescription" rows="4" placeholder="Detailed product description"></textarea>
                <div class="help-text">Complete product description with all details</div>
              </div>
            </div>

            <!-- Pricing & Tax -->
            <div class="form-section">
              <div class="form-section-title">Pricing & Tax</div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productPrice">Base Price (₹) *</label>
                  <input id="productPrice" type="number" step="0.01" min="0" required />
                </div>
                <div class="form-group">
                  <label for="productDiscountPrice">Discount Price (₹)</label>
                  <input id="productDiscountPrice" type="number" step="0.01" min="0" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productMakingCharges">Making Charges (₹)</label>
                  <input id="productMakingCharges" type="number" step="0.01" min="0" />
                </div>
                <div class="form-group">
                  <label for="productGst">GST %</label>
                  <input id="productGst" type="number" step="0.01" min="0" max="100" placeholder="18" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productPriceLabel">Price Label</label>
                  <input id="productPriceLabel" placeholder="Starting from ₹..." />
                </div>
                <div class="form-group">
                  <label for="productCurrency">Currency</label>
                  <select id="productCurrency">
                    <option value="INR">INR (₹)</option>
                    <option value="USD">USD ($)</option>
                  </select>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productOfferStart">Offer Start Date</label>
                  <input id="productOfferStart" type="datetime-local" />
                </div>
                <div class="form-group">
                  <label for="productOfferEnd">Offer End Date</label>
                  <input id="productOfferEnd" type="datetime-local" />
                </div>
              </div>
            </div>

            <!-- Material & Specifications -->
            <div class="form-section">
              <div class="form-section-title">Material & Specifications</div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productMetalType">Metal Type</label>
                  <select id="productMetalType">
                    <option value="">Select</option>
                    <option value="Gold">Gold</option>
                    <option value="Silver">Silver</option>
                    <option value="Platinum">Platinum</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="productPurity">Purity</label>
                  <input id="productPurity" placeholder="18K, 22K, 925 Silver" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productMetalWeight">Metal Weight (grams)</label>
                  <input id="productMetalWeight" type="number" step="0.001" min="0" />
                </div>
                <div class="form-group">
                  <label for="productStoneType">Stone Type</label>
                  <select id="productStoneType">
                    <option value="">None</option>
                    <option value="Diamond">Diamond</option>
                    <option value="Zircon">Zircon</option>
                    <option value="Ruby">Ruby</option>
                    <option value="Emerald">Emerald</option>
                    <option value="Pearl">Pearl</option>
                  </select>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productStoneWeight">Stone Weight (carat)</label>
                  <input id="productStoneWeight" type="number" step="0.01" min="0" />
                </div>
                <div class="form-group">
                  <label for="productStoneCount">Stone Count</label>
                  <input id="productStoneCount" type="number" min="0" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productCertification">Certification</label>
                  <select id="productCertification">
                    <option value="">None</option>
                    <option value="IGI">IGI</option>
                    <option value="GIA">GIA</option>
                    <option value="SGL">SGL</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>Product Sizes & Quantities</label>
                  <div id="variantsContainer" style="margin-top: 10px;">
                    <!-- Variants will be added here -->
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm" id="addVariantBtn" style="margin-top:10px;">+ Add Size Variant</button>
                  <div class="help-text" style="margin-top:8px;">Select size and enter available quantity for each.</div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productLength">Length (mm)</label>
                  <input id="productLength" type="number" step="0.01" min="0" />
                </div>
                <div class="form-group">
                  <label for="productWidth">Width (mm)</label>
                  <input id="productWidth" type="number" step="0.01" min="0" />
                </div>
              </div>
            </div>

            <!-- Inventory -->
            <div class="form-section">
              <div class="form-section-title">Inventory</div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productStockQuantity">Total Stock Quantity</label>
                  <input id="productStockQuantity" type="number" min="0" value="0" />
                  <div class="help-text">Auto-calculated if sizes are added</div>
                </div>
                <div class="form-group">
                  <label for="productLowStockThreshold">Low Stock Threshold</label>
                  <input id="productLowStockThreshold" type="number" min="0" value="5" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productStockStatus">Stock Status</label>
                  <select id="productStockStatus">
                    <option value="in_stock">In Stock</option>
                    <option value="out_of_stock">Out of Stock</option>
                    <option value="low_stock">Low Stock</option>
                  </select>
                </div>
              </div>
            </div>


            <!-- Images & Media -->
            <div class="form-section">
              <div class="form-section-title">Images & Media</div>
              <div class="form-group">
                <label>Upload & crop images (1–5 images)</label>
                <input type="file" id="productImageFile" accept="image/*,.heic,.heif" />
                <div id="productCropper" class="cropper-wrapper" style="display:none;">
                  <div class="cropper-header">
                    <span>Adjust crop (square)</span>
                    <span id="productCropInfo"></span>
                  </div>
                  <div class="cropper-canvas-container">
                    <canvas id="productCropCanvas" width="300" height="300"></canvas>
                  </div>
                  <div class="cropper-controls">
                    <span>Zoom</span>
                    <input type="range" id="productCropZoom" min="0.5" max="2" value="1" step="0.05" />
                    <div style="display:flex; gap:6px;">
                      <button type="button" class="btn btn-secondary" id="productCropCancel">Clear</button>
                      <button type="button" class="btn btn-primary" id="productCropUpload">Upload</button>
                    </div>
                  </div>
                </div>
                <div id="productImagesPreview" class="thumb-grid" style="margin-top:10px;"></div>
              </div>
              
              <div class="form-group" style="margin-top:20px;">
                <label for="productVideoFile">Product Video</label>
                <div style="display:flex; gap:12px; align-items:start;">
                  <div style="flex:1;">
                    <input type="file" id="productVideoFile" accept="video/*" />
                    <div class="help-text">Recommended: MP4 format, under 20MB</div>
                    <div id="productVideoUploadStatus" style="font-size:12px; margin-top:4px;"></div>
                  </div>
                  <div id="productVideoPreview" style="display:none; width:120px; height:120px; position:relative; background:#000; border-radius:8px; overflow:hidden;">
                    <video id="productVideoPlayer" style="width:100%; height:100%; object-fit:cover" muted playsinline></video>
                    <button type="button" id="removeProductVideo" style="position:absolute; top:4px; right:4px; background:rgba(0,0,0,0.5); color:#fff; border:none; border-radius:50%; width:20px; height:20px; cursor:pointer;">×</button>
                  </div>
                </div>
                <input type="hidden" id="productVideoUrl" />
              </div>
            </div>

            <!-- SEO Fields -->
            <div class="form-section">
              <div class="form-section-title">SEO Fields</div>
              <div class="form-group">
                <label for="productMetaTitle">Meta Title</label>
                <input id="productMetaTitle" placeholder="SEO title (50-60 characters)" />
              </div>
              <div class="form-group">
                <label for="productMetaDescription">Meta Description</label>
                <textarea id="productMetaDescription" rows="3" placeholder="SEO description (150-160 characters)"></textarea>
              </div>
              <div class="form-group">
                <label for="productTags">Tags</label>
                <input id="productTags" placeholder="Comma separated tags (e.g., ring, gold, wedding)" />
              </div>
            </div>

            <!-- Shipping Info -->
            <div class="form-section">
              <div class="form-section-title">Shipping Information</div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productWeight">Weight (grams)</label>
                  <input id="productWeight" type="number" step="0.001" min="0" />
                </div>
                <div class="form-group">
                  <label for="productShippingClass">Shipping Class</label>
                  <select id="productShippingClass">
                    <option value="">Standard</option>
                    <option value="express">Express</option>
                    <option value="premium">Premium</option>
                  </select>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="productReturnable">Returnable</label>
                  <select id="productReturnable">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="productWarranty">Warranty</label>
                  <input id="productWarranty" placeholder="e.g., 1 Year, Lifetime" />
                </div>
              </div>
            </div>

            <div id="productFormError" class="error"></div>
          </form>
        </div>
        <div class="large-modal-footer">
          <button type="button" class="btn btn-secondary" id="cancelProductBtn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="saveProductBtn" form="productForm">Save Product</button>
        </div>
      </div>
    </div>

    <!-- Product Image Preview Modal -->
    <div id="productImageModal" class="large-modal">
      <div class="large-modal-content" style="max-width:600px;">
        <div class="large-modal-header">
          <h2>Product Image</h2>
          <button type="button" class="btn btn-secondary" id="closeProductImageModal" style="padding:6px 12px;">×</button>
        </div>
        <div class="large-modal-body" style="display:flex; align-items:center; justify-content:center;">
          <img id="productImageModalImg" src="" alt="Product image" style="max-width:100%; max-height:70vh; border-radius:4px;" />
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteProductModal" class="delete-modal-overlay">
      <div class="delete-modal">
        <div class="delete-modal-header">
          <h3>Delete Product</h3>
        </div>
        <div class="delete-modal-body">
          <p>Are you sure you want to delete this product? This action cannot be undone and will permanently remove the product and all its images.</p>
        </div>
        <div class="delete-modal-actions">
          <button type="button" class="btn btn-secondary" id="deleteProductCancel">Cancel</button>
          <button type="button" class="btn btn-danger" id="deleteProductConfirm">Delete</button>
        </div>
      </div>
    </div>
    `,
    scripts: `
      <script src="/static/js/admin-products.js"></script>
    `
  })
%>
