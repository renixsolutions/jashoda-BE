<%-
  include('../../partials/admin_layout', {
    title: title,
    apiBaseUrl: apiBaseUrl,
    body: `
    <div class="card">
      <div class="card-header">
        <div class="top-actions">
          <h1>Home Video</h1>
          <div style="display:flex; align-items:center; gap:12px; margin-left:auto;">
            <button class="btn btn-primary" id="addVideoBtn">
                <i class="ri-add-line"></i> Add New Video
            </button>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div id="videoTableLoader" class="table-loader">
          <div class="loader"></div>
          <div class="loader-text">Loading videos...</div>
        </div>
        <div id="videoContainer" style="display:none;">
          <table id="videoTable">
            <thead>
              <tr>
                <th style="width:40px;">ID</th>
                <th style="width:120px;">Video</th>
                <th>Texts (Top / Title / Sub / Bottom)</th>
                <th style="width:100px;">Status</th>
                <th style="width:150px;">Actions</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <div id="videoEmptyState" class="empty-state">
          <span>No home videos found.</span>
        </div>
      </div>
    </div>

    <!-- Video Modal -->
    <div id="videoModal" class="large-modal">
      <form id="videoForm" class="large-modal-content" style="display:flex; flex-direction:column; max-height:90vh;">
        <div class="large-modal-header" style="flex-shrink:0;">
          <h2 id="modalTitle">Add Home Video</h2>
          <button type="button" class="btn btn-secondary" id="closeModal" style="padding:8px 14px; min-width:40px;">×</button>
        </div>
        <div class="large-modal-body" style="flex:1; overflow-y:auto;">
          <input type="hidden" id="videoId" name="id">
          
          <div class="form-row">
            <div class="form-group">
              <label for="top_text">Top Text</label>
              <input type="text" id="top_text" name="top_text" placeholder="e.g., A Legacy of Craftsmanship" required>
            </div>
            <div class="form-group">
              <label for="title">Title (White color part)</label>
              <input type="text" id="title" name="title" placeholder="e.g., Welcome to" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="subtitle">Subtitle (Gold color part)</label>
              <input type="text" id="subtitle" name="subtitle" placeholder="e.g., Jashoda Jewels" required>
            </div>
          </div>

          <div class="form-group">
            <label for="bottom_text">Bottom Description text</label>
            <textarea id="bottom_text" name="bottom_text" placeholder="e.g., Discover timeless elegance..." required></textarea>
          </div>

          <div class="form-group">
            <label for="videoFile">Background Video</label>
            <div style="display:flex; gap:15px; align-items:center;">
              <div style="flex:1;">
                <input type="file" id="videoFile" accept="video/mp4,video/x-m4v,video/*">
                <input type="hidden" id="video_url" name="video_url">
                <div style="font-size:11px; color:#6b7280; margin-top:4px;">Upload MP4 video.</div>
              </div>
            </div>
            <div id="videoPreviewContainer" style="display:none; margin-top:10px;">
              <video id="videoPreview" src="" style="width:100%; max-height:200px; border-radius:8px;" controls></video>
            </div>
          </div>

          <div class="form-group" style="margin-top:10px;">
            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; text-transform:none;">
              <input type="checkbox" id="is_active" name="is_active" checked style="width:16px; min-height:16px;">
              <span>Active (Display as main banner on website)</span>
            </label>
          </div>
        </div>
        <div class="large-modal-footer" style="flex-shrink:0;">
          <button type="button" class="btn btn-secondary" id="closeFooter">Cancel</button>
          <button type="submit" class="btn btn-primary" id="saveBtn">Save Video</button>
        </div>
      </form>
    </div>

    <style>
        .large-modal {
            display: none;
            position: fixed;
            z-index: 3000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
        }
        .large-modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .large-modal-content {
            background: white;
            width: 90%;
            max-width: 600px;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }
        .large-modal-header {
            padding: 20px 24px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .large-modal-header h2 {
            margin: 0;
            font-size: 1.25rem;
            color: #111827;
        }
        .large-modal-body {
            padding: 24px;
            max-height: 70vh;
            overflow-y: auto;
        }
        .large-modal-footer {
            padding: 16px 24px;
            background: #f9fafb;
            border-top: 1px solid #eee;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            color: #6b7280;
            margin-bottom: 8px;
        }
        .form-group input[type="text"],
        .form-group input[type="number"],
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
        }
        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }
    </style>
    `,
    scripts: `
      <script src="/static/js/admin-home-videos.js"></script>
    `
  })
%>
