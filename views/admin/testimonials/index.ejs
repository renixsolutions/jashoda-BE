<%-
  include('../../partials/admin_layout', {
    title: title,
    apiBaseUrl: apiBaseUrl,
    body: `
    <div class="card">
      <div class="card-header">
        <div class="top-actions">
          <h1>Customer Testimonials</h1>
          <div style="display:flex; align-items:center; gap:12px; margin-left:auto;">
            <button class="btn btn-primary" id="addTestimonialBtn">
                <i class="ri-add-line"></i> Add Testimonial
            </button>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div id="testimonialsTableLoader" class="table-loader">
          <div class="loader"></div>
          <div class="loader-text">Loading testimonials...</div>
        </div>
        <div id="testimonialsContainer" style="display:none;">
          <table id="testimonialsTable">
            <thead>
              <tr>
                <th style="width:40px;">ID</th>
                <th style="width:80px;">Image</th>
                <th style="width:150px;">Name</th>
                <th>Content</th>
                <th style="width:60px;">Rating</th>
                <th style="width:100px;">Status</th>
                <th style="width:150px;">Actions</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <div id="testimonialsEmptyState" class="empty-state">
          <span>No testimonials found.</span>
        </div>
      </div>
    </div>

    <!-- Testimonial Modal -->
    <div id="testimonialModal" class="large-modal">
      <div class="large-modal-content">
        <div class="large-modal-header">
          <h2 id="modalTitle">Add Testimonial</h2>
          <button type="button" class="btn btn-secondary" id="closeModal" style="padding:8px 14px; min-width:40px;">×</button>
        </div>
        <form id="testimonialForm">
          <div class="large-modal-body">
            <input type="hidden" id="testimonialId" name="id">
            
            <div class="form-row">
              <div class="form-group">
                <label for="name">Customer Name</label>
                <input type="text" id="name" name="name" placeholder="e.g., Akanksha Khanna, 27" required>
              </div>
              <div class="form-group">
                <label for="rating">Rating (1-5)</label>
                <select id="rating" name="rating" required>
                  <option value="5">5 Stars</option>
                  <option value="4">4 Stars</option>
                  <option value="3">3 Stars</option>
                  <option value="2">2 Stars</option>
                  <option value="1">1 Star</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="content">Testimonial Content</label>
              <textarea id="content" name="content" placeholder="Enter what the customer said..." required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="order_index">Order Index</label>
                <input type="number" id="order_index" name="order_index" value="0">
              </div>
              <div class="form-group">
                <label for="rotation">Rotation Angle</label>
                <input type="number" id="rotation" name="rotation" value="0" placeholder="-5 to 5">
              </div>
            </div>

            <div class="form-group">
              <label for="image">Customer Image</label>
              <div style="display:flex; gap:15px; align-items:center;">
                <div id="imagePreview" style="width:80px; height:80px; border:1px solid #ddd; border-radius:8px; overflow:hidden; background:#f9f9f9; display:flex; items-center; justify-center;">
                  <span style="color:#ccc; font-size:10px;">No Image</span>
                </div>
                <div style="flex:1;">
                  <input type="file" id="imageInput" accept="image/*">
                  <input type="hidden" id="image_url" name="image_url">
                  <div style="font-size:11px; color:#6b7280; margin-top:4px;">Upload a square photo for best results.</div>
                </div>
              </div>
            </div>

            <div class="form-group" style="margin-top:10px;">
              <label style="display:flex; align-items:center; gap:8px; cursor:pointer; text-transform:none;">
                <input type="checkbox" id="is_active" name="is_active" checked style="width:16px; min-height:16px;">
                <span>Active (Display on website)</span>
              </label>
            </div>
          </div>
          <div class="large-modal-footer">
            <button type="button" class="btn btn-secondary" id="closeFooter">Cancel</button>
            <button type="submit" class="btn btn-primary" id="saveBtn">Save Testimonial</button>
          </div>
        </form>
      </div>
    </div>

    <div id="testimonialCropper" class="large-modal">
      <div class="large-modal-content" style="max-width: 400px;">
        <div class="large-modal-header">
          <h2>Resize Image</h2>
        </div>
        <div class="large-modal-body" style="text-align:center;">
          <div style="margin-bottom:15px; background:#f0f0f0; border-radius:10px; overflow:hidden;">
            <canvas id="testimonialCropCanvas" style="max-width:100%; cursor:grab;"></canvas>
          </div>
          <div class="form-group">
            <label>Zoom</label>
            <input type="range" id="testimonialCropZoom" min="0.1" max="3" step="0.01" value="1" style="width:100%;">
          </div>
          <p style="font-size:11px; color:#6b7280;">Drag to reposition. We'll save a square version.</p>
        </div>
        <div class="large-modal-footer">
          <button type="button" class="btn btn-secondary" id="testimonialCropCancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="testimonialCropUpload">Crop & Upload</button>
        </div>
      </div>
    </div>

    <style>
        .large-modal {
            display: none;
            position: fixed;
            z-index: 3000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
        }
        .large-modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #testimonialCropper.active {
            z-index: 4000;
        }
        .large-modal-content {
            background: white;
            width: 90%;
            max-width: 600px;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }
        .large-modal-header {
            padding: 20px 24px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .large-modal-header h2 {
            margin: 0;
            font-size: 1.25rem;
            color: #111827;
        }
        .large-modal-body {
            padding: 24px;
            max-height: 70vh;
            overflow-y: auto;
        }
        .large-modal-footer {
            padding: 16px 24px;
            background: #f9fafb;
            border-top: 1px solid #eee;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            color: #6b7280;
            margin-bottom: 8px;
        }
        .form-group input[type="text"],
        .form-group input[type="number"],
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
        }
        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }
    </style>
    `,
    scripts: `
      <script src="/static/js/admin-testimonials.js"></script>
    `
  })
%>
